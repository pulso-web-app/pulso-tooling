      },
      {
        "label": "Pulso Internal: Validate Documentation Shell",
        "type": "shell",
        "command": "npm",
        "args": ["run", "docs:check"],
        "options": {
          "cwd": "${workspaceFolder:Shell}",
        },
        "problemMatcher": [],
        "hide": true,
      },
      {
        "label": "Pulso Internal: Build CRM",
        "type": "shell",
        "command": "npm",
        "args": ["run", "build"],
        "options": {
          "cwd": "${workspaceFolder:CRM}",
        },
        "problemMatcher": [],
        "hide": true,
      },
      {
        "label": "Pulso Internal: Lint CRM",
        "type": "shell",
        "command": "npm",
        "args": ["run", "lint"],
        "options": {
          "cwd": "${workspaceFolder:CRM}",
        },
        "problemMatcher": [],
        "hide": true,
      },
      {
        "label": "Pulso Internal: Test CRM",
        "type": "shell",
        "command": "npm",
        "args": ["test"],
        "options": {
          "cwd": "${workspaceFolder:CRM}",
        },
        "problemMatcher": [],
        "hide": true,
      },
      {
        "label": "Pulso Internal: Run E2E CRM",
        "type": "shell",
