        "args": ["run", "e2e"],
        "options": {
          "cwd": "${workspaceFolder:CRM}",
        },
        "problemMatcher": [],
        "hide": true,
      },
      {
        "label": "Pulso Internal: Check CRM",
        "type": "shell",
        "command": "npm",
        "args": ["run", "check"],
        "options": {
          "cwd": "${workspaceFolder:CRM}",
        },
        "problemMatcher": [],
        "hide": true,
      },
      {
        "label": "Pulso Internal: Validate Specifications CRM",
        "type": "shell",
        "command": "npm",
        "args": ["run", "spec:validate"],
        "options": {
          "cwd": "${workspaceFolder:CRM}",
        },
        "problemMatcher": [],
        "hide": true,
      },
      {
        "label": "Pulso Internal: Validate Documentation CRM",
        "type": "shell",
        "command": "npm",
        "args": ["run", "docs:check"],
        "options": {
          "cwd": "${workspaceFolder:CRM}",
        },
        "problemMatcher": [],
        "hide": true,
      },
      {
        "label": "Pulso Internal: Build Projects",
        "type": "shell",
        "command": "npm",
        "args": ["run", "build"],
        "options": {
          "cwd": "${workspaceFolder:Projects}",
        },
        "problemMatcher": [],
        "hide": true,
      },
      {
        "label": "Pulso Internal: Lint Projects",
        "type": "shell",
        "command": "npm",
        "args": ["run", "lint"],
        "options": {
          "cwd": "${workspaceFolder:Projects}",
        },
        "problemMatcher": [],
        "hide": true,
      },
      {
        "label": "Pulso Internal: Test Projects",
        "type": "shell",
        "command": "npm",
        "args": ["test"],
        "options": {
          "cwd": "${workspaceFolder:Projects}",
        },
        "problemMatcher": [],
        "hide": true,
      },
      {
        "label": "Pulso Internal: Run E2E Projects",
        "type": "shell",
        "command": "npm",
        "args": ["run", "e2e"],
        "options": {
          "cwd": "${workspaceFolder:Projects}",
        },
        "problemMatcher": [],
        "hide": true,
      },
      {
        "label": "Pulso Internal: Check Projects",
        "type": "shell",
        "command": "npm",
        "args": ["run", "check"],
        "options": {
          "cwd": "${workspaceFolder:Projects}",
        },
        "problemMatcher": [],
        "hide": true,
      },
      {
        "label": "Pulso Internal: Validate Specifications Projects",
        "type": "shell",
        "command": "npm",
        "args": ["run", "spec:validate"],
        "options": {
          "cwd": "${workspaceFolder:Projects}",
        },
        "problemMatcher": [],
        "hide": true,
      },
      {
        "label": "Pulso Internal: Validate Documentation Projects",
        "type": "shell",
        "command": "npm",
        "args": ["run", "docs:check"],
        "options": {
          "cwd": "${workspaceFolder:Projects}",
        },
        "problemMatcher": [],
        "hide": true,
      },
    ],
    "inputs": [
      {
        "id": "artifactName",
        "type": "promptString",
        "description": "Artifact name (supports subfolder/name)",
        "default": "new-component",
      },
      {
        "id": "artifactKind",
        "type": "pickString",
        "description": "Angular artifact type",
        "options": [
          {
            "label": "Component",
            "value": "component",
          },
          {
            "label": "Service",
            "value": "service",
          },
          {
            "label": "Guard",
            "value": "guard",
          },
          {
            "label": "Directive",
            "value": "directive",
          },
          {
            "label": "Pipe",
            "value": "pipe",
          },
          {
            "label": "Interceptor",
            "value": "interceptor",
          },
          {
            "label": "Resolver",
            "value": "resolver",
          },
        ],
        "default": "component",
      },
      {
        "id": "terminateAll",
        "type": "command",
        "command": "workbench.action.tasks.terminate",
        "args": "terminateAll",
      },
    ],
  },
}
